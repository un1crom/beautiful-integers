Notebook[{
Cell["\<\
The goal of this project was to predict the next term of any given number \
sequence by using data from OEIS. This was done using a combination of \
machine learning and graphing methods to create functions that would tell you \
what the next term is most likely going to be. \
\>", "Abstract",
 TaggingRules->{},
 CellChangeTimes->{{3.898078791735775*^9, 3.898078829410618*^9}, {
   3.8980791343466187`*^9, 3.898079158772305*^9}, 3.898080477720407*^9, {
   3.898080517846624*^9, 3.898080556405835*^9}, {3.898080654913678*^9, 
   3.8980806938779907`*^9}, {3.89808084137869*^9, 3.898080844408924*^9}, {
   3.898081041961334*^9, 3.898081043291209*^9}, {3.898114619958489*^9, 
   3.898114620942577*^9}, {3.898253370195215*^9, 3.8982533703761673`*^9}, 
   3.898254098422986*^9, {3.898254164704192*^9, 3.898254274047319*^9}},
 CellTags->{"Abstract", "TemplateCell"},
 CellID->587432573,ExpressionUUID->"37344f18-7789-41ba-8d69-2a5359d52fa1"],

Cell[CellGroupData[{

Cell["Importing OEIS Data", "Section",
 TaggingRules->{},
 CellChangeTimes->{{3.897810894365017*^9, 3.897810897767067*^9}, {
