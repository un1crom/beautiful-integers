Cell["\<\
The last two methods use the same data. However they organized differently. \
One of them is in a spiral layout, the other is a circle.\
\>", "CodeText",
 TaggingRules->{},
 CellChangeTimes->{{3.898252951962426*^9, 3.898252961466281*^9}, {
  3.898253049831368*^9, 3.8982530982743473`*^9}},
 CellID->233959111,ExpressionUUID->"7c5d52ed-e9dd-4133-97cd-3fc9fd633a80"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"method3Set1", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Part", "[", 
          RowBox[{"#", ",", "n"}], "]"}], "->", 
         RowBox[{"Part", "[", 
          RowBox[{"#", ",", 
           RowBox[{"n", "+", "1"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", 
          RowBox[{"Range", "[", 
           RowBox[{"1", ",", "10"}], "]"}]}], "}"}]}], "]"}], "&"}], "/@", 
     "sequence3"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"method3Set2", "=", 
   RowBox[{"DeleteDuplicates", "[", "method3Set1", "]"}]}], ";"}]}], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.898185042285342*^9, 3.8981850464003963`*^9}, {
   3.898185431418255*^9, 3.898185438410255*^9}, 3.89825155651758*^9, 
   3.8982516742547817`*^9, {3.898252847882732*^9, 3.898252848109977*^9}},
 CellLabel->"In[526]:=",
 CellID->1427481351,ExpressionUUID->"d2ba221a-339a-45b8-9c09-b7cd510ebdb3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"spiralLayout", "[", "n_", "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"i", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", 
          RowBox[{"2", "*", "\[Pi]", "*", " ", 
           RowBox[{"i", "/", 
            RowBox[{"(", 
             RowBox[{"n", "/", "3"}], ")"}]}]}], "]"}], "*", 
         RowBox[{"i", "/", "20"}]}], ",", 
        RowBox[{
         RowBox[{"Sin", "[", 
          RowBox[{"2", "*", "\[Pi]", "*", " ", 
           RowBox[{"i", "/", 
            RowBox[{"(", 
             RowBox[{"n", "/", "3"}], ")"}]}]}], "]"}], "*", 
         RowBox[{"i", "/", "20"}]}]}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "n"}], "}"}]}], "]"}]}], ";"}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.8979947303311443`*^9, 3.8979947725242434`*^9}, 
   3.8980030345996857`*^9, {3.89800316338621*^9, 3.898003164115144*^9}, {
   3.898003355905736*^9, 3.898003357247307*^9}, {3.898003607003446*^9, 
   3.898003607724758*^9}, {3.898003754982566*^9, 3.898003920210902*^9}, {
   3.8980039529381313`*^9, 3.898003964571251*^9}, {3.898207366984429*^9, 
   3.89820737143777*^9}},
 CellLabel->"In[420]:=",
 CellID->1975901969,ExpressionUUID->"74b8dc2d-f6aa-4859-abd6-b849d5a5dae4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"UndirectedGraph", "[", 
  RowBox[{"method3Set2", ",", 
   RowBox[{"VertexLabels", "->", "\"\<Name\>\""}], ",", 
   RowBox[{"VertexCoordinates", "->", 
    RowBox[{"spiralLayout", "[", "100", "]"}]}]}], "]"}]], "Input",
 TaggingRules->{},
