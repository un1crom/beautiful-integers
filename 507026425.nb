Cell[CellGroupData[{

Cell["Using Graphs", "Section",
 TaggingRules->{},
 CellChangeTimes->{{3.89818153753194*^9, 3.898181538537384*^9}, {
  3.898181577294969*^9, 3.89818157848885*^9}},
 CellID->1460498181,ExpressionUUID->"b1b5ae2d-2fe3-4678-933e-0abd9d77130d"],

Cell["\<\
Due to the fact that Classify is somewhat unreliable and that making a neural \
network would take too much time and data, I then tried to use graphs to \
visualize and also predict the sequences.\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.898246389889841*^9, 3.898246418826765*^9}, {
  3.898246473403846*^9, 3.8982465205732813`*^9}, {3.8982466926616173`*^9, 
  3.898246719441772*^9}, {3.898266252585237*^9, 3.898266273928084*^9}},
 CellID->1670962847,ExpressionUUID->"43ec0190-d4c3-4cf9-8d49-dc4098cd4371"],

Cell[CellGroupData[{

Cell["Predict", "Subsection",
 TaggingRules->{},
 CellChangeTimes->{{3.8981816147050667`*^9, 3.8981816203764353`*^9}},
 CellID->1156824514,ExpressionUUID->"0a02c919-392a-48b8-90ae-5163ac48db4d"],

Cell["\<\
In order to predict the next term in a sequence, I realized that the \
positions of the terms matters a lot. When using Classify, I learned that \
Classify doesn't care about the order of the numbers. So when using this \
method, it made sense to create coordinates that contained the terms and its \
position in the sequence. \
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.898250008595765*^9, 3.8982500229840107`*^9}, {
  3.898250179188753*^9, 3.8982503080257587`*^9}, {3.898250561471229*^9, 
  3.89825056490902*^9}, {3.898258541622197*^9, 3.898258543558601*^9}, {
  3.898266304326169*^9, 3.898266314468246*^9}},
 CellID->1378420324,ExpressionUUID->"5802d5a9-23e6-4d49-84c9-e72cf40ab319"],

Cell["\<\
I created coordinates containing a term and it's position. Then I associated \
a coordinate pair with the coordinate pair that contains the next term:\
\>", "CodeText",
 TaggingRules->{},
 CellChangeTimes->{{3.8982503122393837`*^9, 3.898250319820491*^9}, {
  3.898258598397212*^9, 3.898258603943132*^9}, {3.898260092344493*^9, 
  3.898260092523932*^9}},
 CellID->397095818,ExpressionUUID->"9b97b2c5-fb95-475e-81e0-1a126798a7ca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"method1Set1", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Part", "[", 
             RowBox[{"#", ",", "n"}], "]"}], "}"}], ",", 
           RowBox[{"{", "n", "}"}]}], "]"}], "->", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Part", "[", 
             RowBox[{"#", ",", 
              RowBox[{"n", "+", "1"}]}], "]"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"n", "+", "1"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", 
          RowBox[{"Range", "[", 
           RowBox[{"1", ",", "10"}], "]"}]}], "}"}]}], "]"}], "&"}], "/@", 
     "sequence3"}], "]"}]}], ";"}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.8980769908412027`*^9, 3.8980770029956827`*^9}, {
  3.898249881784707*^9, 3.898249891572184*^9}},
 CellLabel->"In[510]:=",
 CellID->223303126,ExpressionUUID->"18684890-3df3-4184-bb3f-89d4d5809ec7"],

Cell["\<\
 Then I used it to predict what the next term is when given a sequence. In \
order to predict the next term, I found the most common next term:\
\>", "CodeText",
 TaggingRules->{},
 CellChangeTimes->{{3.8982504232007923`*^9, 3.898250480909362*^9}, {
  3.898259577647235*^9, 3.898259751104673*^9}},
 CellID->431055336,ExpressionUUID->"862de172-f19f-476e-89a7-24caf25db121"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"cases", "[", "x_List", "]"}], ":=", 
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{"ReverseSort", "[", 
      RowBox[{"Counts", "[", 
       RowBox[{"Select", "[", 
        RowBox[{"method1Set1", ",", 
         RowBox[{
          RowBox[{"MatchQ", "[", 
           RowBox[{"#", ",", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"x", "[", 
                RowBox[{"[", 
                 RowBox[{"-", "1"}], "]"}], "]"}], ",", 
               RowBox[{"Length", "[", "x", "]"}]}], "}"}], "->", 
             RowBox[{"{", 
              RowBox[{"_", ",", "_"}], "}"}]}]}], "]"}], "&"}]}], "]"}], 
       "]"}], "]"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "1", ",", "2", ",", "1"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cases", "[", "___", "]"}], ":=", 
  "\"\<Please input a list\>\""}]}], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.89807642810748*^9, 3.8980764469759083`*^9}, {
   3.8980769633716097`*^9, 3.898076986809205*^9}, {3.8980770182889233`*^9, 
   3.8980770186616087`*^9}, {3.898184922273019*^9, 3.898184923315497*^9}, 
   3.898185001951811*^9, {3.898249907643845*^9, 3.898249909528797*^9}, {
   3.8982504841811733`*^9, 3.898250486965707*^9}},
 CellLabel->"In[515]:=",
 CellID->1401707373,ExpressionUUID->"3ed80f38-5122-4b02-b172-803452fbc5d0"],

Cell["\<\
As shown below, this method has a similar accuracy rate to Classify. But it \
only work for non-decreasing sequences:\
\>", "CodeText",
 TaggingRules->{},
 CellChangeTimes->{{3.898250569222925*^9, 3.8982506032334347`*^9}, {
  3.898253456448555*^9, 3.898253497759284*^9}, {3.898259635612905*^9, 
  3.8982596366615343`*^9}, {3.898259833778277*^9, 3.898259837988373*^9}},
 CellID->1193270878,ExpressionUUID->"07b51308-8f8e-4abd-b4d9-619268aca174"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"cases", "[", 
  RowBox[{"{", 
   RowBox[{"0", ",", "1", ",", "2", ",", "3"}], "}"}], "]"}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.898250477865212*^9, 3.898250502589755*^9}},
 CellLabel->"In[517]:=",
 CellID->1535868339,ExpressionUUID->"3362c47d-055e-45ed-96ce-96c136a6e207"],

Cell[BoxData["4"], "Output",
 TaggingRules->{},
 CellChangeTimes->{3.8982505034558477`*^9},
 CellLabel->"Out[517]=",
 CellID->60096023,ExpressionUUID->"69aaa5c0-8e0c-4386-8265-98db36696c7d"]
