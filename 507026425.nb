Cell[BoxData[{
 RowBox[{
  RowBox[{"data1000", " ", "=", " ", 
   RowBox[{"CloudGet", "[", 
    TemplateBox[{
     "\"https://www.wolframcloud.com/obj/7f7c407b-fbee-4fc4-99be-973276ae1a1d\
\"", "https://www.wolframcloud.com/obj/7f7c407b-fbee-4fc4-99be-973276ae1a1d"},
     
     "HyperlinkURL"], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"list1000", "=", 
   RowBox[{"StringSplit", "[", 
    RowBox[{"Drop", "[", 
     RowBox[{
      RowBox[{"StringSplit", "[", 
       RowBox[{"data1000", ",", "\"\<\\n\>\""}], "]"}], ",", "4"}], "]"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stringList1000", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
       RowBox[{"Drop", "[", 
        RowBox[{"#", ",", " ", "1"}], "]"}]}], "}"}], " ", "&"}], " ", "/@", 
    " ", "list1000"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sequencesList1000", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
       RowBox[{"ToExpression", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"StringSplit", "[", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", " ", "\"\<,\>\""}], "]"}], 
         "]"}], "]"}]}], "}"}], " ", "&"}], " ", "/@", " ", 
    "stringList1000"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sequencesAssoc1000", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "->", 
       RowBox[{"#", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "&"}], "/@", "sequencesList1000"}], 
    "|>"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
