Cell["\<\
The second method has restricts it so that all the sequences are \
non-decreasing and that the associations has been repeat at least 20 times  : \
\>", "CodeText",
 TaggingRules->{},
 CellChangeTimes->{{3.8982514786921787`*^9, 3.898251515199224*^9}, {
  3.898252427545722*^9, 3.898252449071879*^9}, {3.898252525322093*^9, 
  3.89825252868419*^9}, {3.89825255992535*^9, 3.898252591177853*^9}, {
  3.898259782974629*^9, 3.898259789020713*^9}},
 CellID->1919600691,ExpressionUUID->"4464daa2-20da-430b-b8b4-28c2940dd5db"],

Cell[BoxData[
 RowBox[{
  RowBox[{"method1Set2", "=", 
   RowBox[{"Keys", "[", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"Counts", "[", "method1Set1", "]"}], ",", 
      RowBox[{
       RowBox[{"#", ">", "20"}], "&"}]}], "]"}], "]"}]}], ";"}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{3.898252554988583*^9},
 CellID->836719077,ExpressionUUID->"994c0709-d1c9-414c-9772-c9e8cf46bb97"],

Cell["\<\
The graph, as shown below, also creates a similar pattern. It also presents \
the pattern in a wider range when given more data:\
\>", "CodeText",
 TaggingRules->{},
 CellChangeTimes->{{3.898252690649076*^9, 3.8982527224703197`*^9}, {
  3.898261071740994*^9, 3.8982611203939734`*^9}, {3.898266374454905*^9, 
  3.898266375523328*^9}},
 CellID->8657359,ExpressionUUID->"1673c329-9791-4ae6-8c74-a105bfad7bf6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DirectedGraph", "[", 
  RowBox[{"method1Set2", ",", 
   RowBox[{
    RowBox[{
     RowBox[{"VertexLabels", "->", 
      RowBox[{"#", "->", 
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], "&"}], "/@", 
    RowBox[{"DeleteDuplicates", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "&"}], ",", 
         "method1Set2"}], "]"}], ",", "1"}], "]"}], "]"}]}], ",", 
   RowBox[{"VertexCoordinates", "->", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"10", "-", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], "&"}], "/@", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "&"}], ",", 
           "method1Set2"}], "]"}], ",", "1"}], "]"}], "]"}]}], ")"}]}]}], 
  "]"}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.8981838177477837`*^9, 3.8981838218217*^9}, {
   3.898183865893393*^9, 3.898183867370645*^9}, {3.898183910830699*^9, 
   3.898183912475232*^9}, {3.898184034780197*^9, 3.8981840409354477`*^9}, {
