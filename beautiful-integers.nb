(* Content-type: application/vnd.wolfram.mathematica *)

(*** Wolfram Notebook File ***)
(* http://www.wolfram.com/nb *)

Notebook[{

Cell[CellGroupData[{
Cell["Beautiful Integers: OEIS Beauty Hunt (Phase 1)", "Title"],
Cell["A Wolfram Language exploration of drama, tension, and surprise in sequences.", "Subtitle"],
Cell["Primary question: which integer sequences feel mathematically beautiful, and why?", "Text"]
}, Open  ]],

Cell[CellGroupData[{
Cell["1. Historical Beauty Notes", "Section"],
Cell["Beauty in number theory often mixes strict law and perceived chaos.", "Text"],
Cell["Classical anchors for this project:", "Text"],
Cell["Euclid's proof of infinitely many primes sets an early aesthetic benchmark.", "Item"],
Cell["Fibonacci/Hemachandra growth links arithmetic recurrences to geometry and limiting structure.", "Item"],
Cell["Hardy and Ramanujan's partition asymptotics blend exact arithmetic with surprising analytic behavior.", "Item"],
Cell["Self-referential sequences (like Kolakoski) amplify mystery through short rules and hard global behavior.", "Item"],
Cell["Recaman's sequence demonstrates dramatic visual structure from a tiny greedy rule.", "Item"]
}, Open  ]],

Cell[CellGroupData[{
Cell["2. Phase-1 Sequence Set (5 total)", "Section"],
Cell["The initial research slate:", "Text"],
Cell["A000045 Fibonacci numbers - https://oeis.org/A000045", "Item"],
Cell["A000040 Prime numbers - https://oeis.org/A000040", "Item"],
Cell["A000041 Partition numbers - https://oeis.org/A000041", "Item"],
Cell["A005132 Recaman sequence - https://oeis.org/A005132", "Item"],
Cell["A000002 Kolakoski sequence - https://oeis.org/A000002", "Item"],
Cell["Each sequence is profiled by OEIS metadata, structural metrics, and multiple visual embeddings.", "Text"]
}, Open  ]],

Cell[CellGroupData[{
Cell["2b. Online OEIS Queries", "Section"],
Cell["Direct OEIS API probe from Wolfram Language:", "Text"],
Cell["Import[\"https://oeis.org/search?fmt=json&q=id:A000045\", \"RawJSON\"]", "Input"],
Cell["Get only b-file terms for one sequence:", "Text"],
Cell["Import[\"https://oeis.org/A005132/b005132.txt\", \"Lines\"] // Take[#, 20] &", "Input"],
Cell["You can swap sequence IDs and compare commentary, formulas, and links from OEIS pages.", "Text"]
}, Open  ]],

Cell[CellGroupData[{
Cell["3. Load Engine and Run", "Section"],
Cell["Run this once per session:", "Text"],
Cell["SetDirectory[NotebookDirectory[]];\nGet[\"beautiful-integers.wl\"];", "Input"],
Cell["Execute the full phase-1 research pass:", "Text"],
Cell["result = RunBeautifulResearch[\n  \"TermCount\" -> 240,\n  \"Modulus\" -> 12,\n  \"GridWidth\" -> 24,\n  \"EnableAnimations\" -> True\n];", "Input"],
Cell["result[\"RankedIDs\"]", "Input"],
Cell["Output files are written to ./outputs.", "Text"]
}, Open  ]],

Cell[CellGroupData[{
Cell["4. Beauty Lenses", "Section"],
Cell["Exploratory metrics used in this notebook:", "Text"],
Cell["Compressibility: proxy for generative simplicity.", "Item"],
Cell["DeltaSignEntropy: unpredictability of local directional changes.", "Item"],
Cell["GrowthDrama: volatility in log-magnitude increments.", "Item"],
Cell["ResidueStructure: degree of modular regularity.", "Item"],
Cell["Novelty: ratio of distinct values across sampled terms.", "Item"],
Cell["BeautyIndex is a weighted blend for ranking only; it is not a theorem.", "Text"]
}, Open  ]],

Cell[CellGroupData[{
Cell["5. Inspect Summaries", "Section"],
Cell["Load machine-readable summary:", "Text"],
Cell["summary = Import[FileNameJoin[{NotebookDirectory[], \"outputs\", \"summary.json\"}], \"RawJSON\"];", "Input"],
Cell["Dataset[summary[[All, {\"id\", \"label\", \"beauty_profile\"}]]]", "Input"],
Cell["Beauty atlas picks (auto-selected striking views):", "Text"],
Cell["Dataset[summary[[All, {\"id\", \"atlas_view\", \"atlas_score\"}]]]", "Input"],
Cell["Interactive atlas/coagulation viewer (best + blend + tile):", "Text"],
Cell["outputDir = FileNameJoin[{NotebookDirectory[], \"outputs\"}];\nids = summary[[All, \"id\"]];\nDynamicModule[{id = First[ids], view = \"coagulation-blend\"},\n Column[{\n   Row[{\"Sequence: \", PopupMenu[Dynamic[id], ids], Spacer[22], \"View: \", PopupMenu[Dynamic[view], {\"coagulation-blend\", \"coagulation-tile\", \"coagulation\", \"atlas\"}]}],\n   Dynamic@Module[{path = FileNameJoin[{outputDir, id <> \"-\" <> view <> \".png\"}]},\n     If[FileExistsQ[path], Import[path], Style[\"Missing image: \" <> FileNameTake[path], Red]]\n   ]\n }, Spacings -> 1.2]\n]", "Input"],
Cell["Read textual report:", "Text"],
Cell["Pane[Import[FileNameJoin[{NotebookDirectory[], \"outputs\", \"beauty-report.md\"}], \"Text\"], {Automatic, 260}, Scrollbars -> True]", "Input"]
}, Open  ]],

Cell[CellGroupData[{
Cell["6. Visualization Gallery", "Section"],
Cell["Graph inspiration note: the circle/spiral transition layouts are adapted into the reusable engine from ideas similar to your imported 507026425 notebook.", "Text"],
Cell["Explore one rendered view at a time to keep presentation mode clean:", "Text"],
Cell["outputDir = FileNameJoin[{NotebookDirectory[], \"outputs\"}];\nids = {\"A000045\", \"A000040\", \"A000041\", \"A005132\", \"A000002\"};\nviews = <|\n  \"coagulation (best mode)\" -> \"coagulation\",\n  \"coagulation (blend)\" -> \"coagulation-blend\",\n  \"coagulation (tile)\" -> \"coagulation-tile\",\n  \"atlas\" -> \"atlas\",\n  \"line\" -> \"line\",\n  \"difference\" -> \"difference\",\n  \"phase portrait\" -> \"phase\",\n  \"recurrence texture\" -> \"recurrence\",\n  \"modular circle\" -> \"mod-circle\",\n  \"modular spiral\" -> \"mod-spiral\",\n  \"digit graph\" -> \"digitgraph\",\n  \"residues\" -> \"residue\",\n  \"digit texture\" -> \"digits\",\n  \"Recaman arcs\" -> \"arcs\",\n  \"Kolakoski runs\" -> \"runs\"\n|>;\nDynamicModule[{id = First[ids], view = \"coagulation (best mode)\"},\n Column[{\n   Row[{\"Sequence: \", PopupMenu[Dynamic[id], ids], Spacer[22], \"View: \", PopupMenu[Dynamic[view], Keys[views]]}],\n   Dynamic@Module[{path = FileNameJoin[{outputDir, id <> \"-\" <> views[view] <> \".png\"}]},\n     If[FileExistsQ[path], Import[path], Style[\"View not available for this sequence: \" <> view, Orange]]\n   ]\n }, Spacings -> 1.2]\n]", "Input"],
Cell["Optional special visuals:", "Text"],
Cell["Grid[{{Import[FileNameJoin[{outputDir, \"A005132-arcs.png\"}]], Import[FileNameJoin[{outputDir, \"A000002-runs.png\"}]]}}, Spacings -> {1.4, 1.2}]", "Input"]
}, Open  ]],

Cell[CellGroupData[{
Cell["6b. Direct Graph Lab", "Section"],
Cell["Generate graph-lab visuals directly in notebook without exporting:", "Text"],
Cell["rec = LoadTerms[\"A005132\", 260];\nGrid[{{ModularTransitionGraphCircle[\"A005132\", rec, 97], ModularTransitionGraphSpiral[\"A005132\", rec, 97]}}]", "Input"],
Cell["p = LoadTerms[\"A000040\", 260];\nTabView[<|\n  \"Return-map\" -> ReturnMapPhasePlot[\"A000040\", p],\n  \"Recurrence\" -> ResidueRecurrencePlot[\"A000040\", p, 89],\n  \"Digit graph\" -> DigitTransitionGraph[\"A000040\", p]\n|>]", "Input"]
}, Open  ]],

Cell[CellGroupData[{
Cell["6c. Animation Studio", "Section"],
Cell["Term-count sweep animations (graph drama):", "Text"],
Cell["ids = {\"A000045\", \"A000040\", \"A000041\", \"A005132\", \"A000002\"};\noutputDir = FileNameJoin[{NotebookDirectory[], \"outputs\"}];\nloadDrama[id_, kind_] := Module[{mp4, gif},\n  mp4 = FileNameJoin[{outputDir, id <> \"-\" <> kind <> \".mp4\"}];\n  gif = FileNameJoin[{outputDir, id <> \"-\" <> kind <> \".gif\"}];\n  Which[\n    FileExistsQ[mp4], Import[mp4],\n    FileExistsQ[gif], Import[gif],\n    True, Style[\"Missing animation: \" <> id <> \" \" <> kind, Red]\n  ]\n];\nDynamicModule[{id = First[ids], kindLabel = \"circle drama\", kinds},\n  kinds = <|\"circle drama\" -> \"drama-circle\", \"spiral drama\" -> \"drama-spiral\"|>;\n  Column[{\n    Row[{\"Sequence: \", PopupMenu[Dynamic[id], ids], Spacer[22], \"Animation: \", PopupMenu[Dynamic[kindLabel], Keys[kinds]]}],\n    Dynamic[loadDrama[id, kinds[kindLabel]]]\n  }, Spacings -> 1.2]\n]", "Input"],
Cell["Regenerate with denser animation frames:", "Text"],
Cell["result = RunBeautifulResearch[\n  \"TermCount\" -> 260,\n  \"AnimationFrames\" -> 18,\n  \"AnimationMinTerms\" -> 20,\n  \"Modulus\" -> 12,\n  \"GridWidth\" -> 24,\n  \"EnableAnimations\" -> True\n];\nresult[\"RankedIDs\"]", "Input"]
}, Open  ]],

Cell[CellGroupData[{
Cell["7. Sequence-Specific Deep Dives", "Section"],
Cell["Fibonacci: convergence of term ratios toward the golden ratio.", "Text"],
Cell["fibRatios = N[Table[Fibonacci[n + 1]/Fibonacci[n], {n, 2, 40}]];\nListLinePlot[fibRatios, PlotRange -> All, PlotLabel -> \"Fibonacci ratio convergence\"]", "Input"],
Cell["Primes: compare p_n against n Log n.", "Text"],
Cell["nmax = 280;\nprimes = Prime /@ Range[nmax];\napprox = Range[nmax] Log[Range[nmax]];\nListLinePlot[{primes, approx}, PlotLegends -> {\"p_n\", \"n log n\"}, PlotRange -> All]", "Input"],
Cell["Partitions: generating function coefficients.", "Text"],
Cell["partSeries = Normal @ Series[Product[1/(1 - x^k), {k, 1, 20}], {x, 0, 20}];\nCoefficientList[partSeries, x]", "Input"],
Cell["Recaman: arc portrait from built-in geometry primitives.", "Text"],
Cell["rec = RecamanTerms[220];\nRecamanArcPlot[rec, 180]", "Input"],
Cell["Kolakoski: self-generating run-length check.", "Text"],
Cell["k = KolakoskiTerms[260];\nruns = Length /@ Split[k];\n{Take[k, Length[runs]] === runs, Tally[k]}", "Input"]
}, Open  ]],

Cell[CellGroupData[{
Cell["8. Next-Stage Beauty Hunt Protocol", "Section"],
Cell["After validating phase 1, expand to larger candidate pools.", "Text"],
Cell["Scale-up plan:", "Text"],
Cell["1) Harvest candidates by OEIS keyword themes (self-referential, prime-adjacent, combinatorial growth, morphic words).", "Item"],
Cell["2) Run the same metric pipeline to create comparable beauty signatures.", "Item"],
Cell["3) Cluster signatures and manually inspect high-variance outliers.", "Item"],
Cell["4) Keep only sequences that score high in at least two orthogonal lenses (structure + surprise).", "Item"],
Cell["5) Build a final presentation notebook around the strongest discoveries.", "Item"],
Cell["Seed IDs for stage 2 (editable):", "Text"],
Cell["candidateIDs = {\"A005150\", \"A006720\", \"A001223\", \"A001065\", \"A051953\", \"A006577\"};\nDataset[candidateIDs]", "Input"]
}, Open  ]],

Cell[CellGroupData[{
Cell["9. Command-Line Runner", "Section"],
Cell["CLI execution (same directory):", "Text"],
Cell["WolframKernel=/Applications/Wolfram.app/Contents/MacOS/WolframKernel wolframscript run-beautiful-integers.wls", "Code"],
Cell["If activation blocks execution, activate Wolfram first and rerun the same command.", "Text"]
}, Open  ]]

},
WindowSize->{1200, 920},
WindowMargins->{{120, Automatic}, {40, Automatic}},
ScreenStyleEnvironment->"SlideShow",
Magnification:>1.1 Inherited,
StyleDefinitions->"Default.nb"
]
