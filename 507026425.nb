Cell[TextData[StyleBox["For both of these graphs, the more data there is, \
higher the chance of a number going back to itself. ", "Text"]], "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.898258889161212*^9, 3.8982588957707977`*^9}, {
  3.898262218233316*^9, 3.898262269111867*^9}, {3.8982623622998743`*^9, 
