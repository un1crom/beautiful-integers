 CellID->198432476,ExpressionUUID->"52e40e71-899a-4a3a-b4cb-f791e5c480f2"],

Cell["\<\
 The On-Line Encyclopedia of Integer Sequences, or OEIS, is a tool that many \
mathematicians and other scientists use find sequences that have been \
discovered. OEIS contains over 300,000 number sequences.\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.89808040702767*^9, 3.898080407887322*^9}, {
   3.8980808231753387`*^9, 3.898080845644095*^9}, {3.8980809679830637`*^9, 
   3.8980810310793753`*^9}, {3.898088707153639*^9, 3.898088742561122*^9}, {
   3.898254332072592*^9, 3.8982543426569433`*^9}, 3.8982562082539253`*^9, {
   3.898256239562297*^9, 3.89825623975816*^9}, {3.8982591916195307`*^9, 
   3.8982591985433702`*^9}},
 CellID->1645826923,ExpressionUUID->"cf771f73-d4ca-4ecd-9bee-820082a6c340"],

