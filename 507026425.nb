   3.8982637100368013`*^9, 3.898263712585065*^9}},
 CellID->146086666,ExpressionUUID->"d51edfcd-7800-48e8-80ea-d5abec634c4e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"classifyTrainingSet2", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"Prepend", "[", 
           RowBox[{
            RowBox[{"Take", "[", 
             RowBox[{"#", ",", "n"}], "]"}], ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"0", "*", "x"}], ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", 
                RowBox[{"10", "-", "n"}]}], "}"}]}], "]"}]}], "]"}], "]"}], "->", 
         RowBox[{"Part", "[", 
          RowBox[{"#", ",", 
           RowBox[{"n", "+", "1"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", 
          RowBox[{"Range", "[", 
           RowBox[{"1", ",", "10"}], "]"}]}], "}"}]}], "]"}], "&"}], "/@", 
     "sequence2"}], "]"}]}], ";"}]], "Input",
 TaggingRules->{},
