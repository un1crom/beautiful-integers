 CellID->815053648,ExpressionUUID->"1927121f-f619-4303-9e1c-8d625d4dc80d"],

Cell["\<\
I imported the data for the first 10,000 sequences in the OEIS Data:\
\>", "CodeText",
 TaggingRules->{},
 CellChangeTimes->{{3.8982042628930407`*^9, 3.898204264559751*^9}, {
  3.898206495967346*^9, 3.8982065194045057`*^9}, {3.898206822331069*^9, 
