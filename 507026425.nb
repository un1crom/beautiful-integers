 CellID->1368418446,ExpressionUUID->"c8747f05-e615-410c-a521-bf0375bd6b31"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sequencesAssoc", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "->", 
