Cell[CellGroupData[{

Cell["Visualize", "Subsection",
 TaggingRules->{},
 CellChangeTimes->{{3.898181625112134*^9, 3.898181629314183*^9}},
 CellID->2059189580,ExpressionUUID->"7a346c82-8552-4d68-8dca-af4bdf38d3ef"],

Cell["\<\
I used 4 different methods to visualize the sequences. The first two methods \
use coordinates to plot the terms. The last two methods just take a term and \
the next term. This allows for us to see the connections of terms regardless \
of position.  All the methods contains sequences with more than 10 terms, \
have positive terms, and had terms smaller than 100.\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.898250991385903*^9, 3.898250996654055*^9}, {
   3.898251065281287*^9, 3.898251171149294*^9}, {3.898251521865073*^9, 
   3.898251543032493*^9}, {3.898251682605331*^9, 3.898251694466016*^9}, {
   3.89825178428098*^9, 3.898251787550569*^9}, {3.898252735104471*^9, 
   3.898252807121913*^9}, {3.8982529649871798`*^9, 3.8982529840439043`*^9}, 
   3.898253026915921*^9, {3.898262548795146*^9, 3.8982626258032207`*^9}},
 CellID->604630528,ExpressionUUID->"fd5b50b3-2b31-4165-a75a-f97fc794663a"],

Cell["\<\
This method doesn't add any other restrictions. But in order to make the \
graph less chaotic, I only used the first 1000 sequences and removed the \
associations that don't repeat at least 6 times :\
\>", "CodeText",
 TaggingRules->{},
 CellChangeTimes->{{3.8982509544967747`*^9, 3.8982509786565313`*^9}, {
  3.8982511838694344`*^9, 3.8982511920525312`*^9}, {3.898251307103981*^9, 
  3.89825134158709*^9}, {3.898251371826706*^9, 3.898251400275096*^9}, {
  3.898251792569186*^9, 3.898251813593411*^9}},
 CellID->897914505,ExpressionUUID->"6dc21a62-97d2-4986-a62b-5f5f24be1f2a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sequence4", "=", 
   RowBox[{"sequence2", "[", 
    RowBox[{"[", 
     RowBox[{"1", ";;", "1000"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"method2Set1", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Part", "[", 
             RowBox[{"#", ",", "n"}], "]"}], "}"}], ",", 
           RowBox[{"{", "n", "}"}]}], "]"}], "->", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Part", "[", 
             RowBox[{"#", ",", 
              RowBox[{"n", "+", "1"}]}], "]"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"n", "+", "1"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", 
          RowBox[{"Range", "[", 
           RowBox[{"1", ",", "10"}], "]"}]}], "}"}]}], "]"}], "&"}], "/@", 
     "sequence4"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"method2Set2", "=", 
   RowBox[{"Keys", "[", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"Counts", "[", "method2Set1", "]"}], ",", 
      RowBox[{
       RowBox[{"#", ">", "6"}], "&"}]}], "]"}], "]"}]}], ";"}]}], "Input",
 TaggingRules->{},
 CellChangeTimes->{
  3.898248267040958*^9, {3.898248317461782*^9, 3.898248317554864*^9}, {
   3.898248627321245*^9, 3.898248638541439*^9}, 3.898248672998354*^9, 
   3.8982487667427883`*^9, {3.89824912131923*^9, 3.898249121794482*^9}, {
