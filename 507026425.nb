Cell[CellGroupData[{

Cell["Using Classify", "Section",
 TaggingRules->{},
 CellChangeTimes->{{3.898088303046373*^9, 3.898088312577857*^9}, {
  3.898097990704865*^9, 3.898097992527232*^9}, {3.898175728548038*^9, 
  3.8981757310052357`*^9}, {3.8981769188600073`*^9, 3.89817692206371*^9}, {
  3.898197026025075*^9, 3.8981970279216213`*^9}},
 CellID->720700692,ExpressionUUID->"b9831535-87e1-47e5-a954-884ba81a380b"],

Cell["\<\
Classify is the first thing I tried. However, I discovered that Classify \
isn't reliable with this kind of input, a list of varying lengths that is \
order-dependent, due to it being inaccurate quite often. I adjusted the input \
with 2 different methods. The first way I tried was by using strings.\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.898088627657905*^9, 3.898088643728558*^9}, {
   3.898088815443699*^9, 3.898088895604114*^9}, {3.898097976042157*^9, 
   3.8980980182030067`*^9}, {3.898098055134009*^9, 3.898098078442586*^9}, {
   3.898098216941593*^9, 3.8980982399464207`*^9}, 3.898098389287075*^9, {
   3.8980985148912697`*^9, 3.898098527938609*^9}, 3.8981570095220423`*^9, {
   3.898157051472621*^9, 3.898157063601121*^9}, {3.8981634294022007`*^9, 
   3.89816343026234*^9}, {3.8981755789301643`*^9, 3.898175607119754*^9}, {
   3.8981762768184147`*^9, 3.898176279037487*^9}, 3.898206798585779*^9, {
   3.898259264537592*^9, 3.8982593820268383`*^9}},
 CellID->1678525739,ExpressionUUID->"53346a50-b213-4b73-a53a-3a2414ce357a"],

Cell["\<\
 I first made the sequences into a strings with terms, separated by spaces, \
that would be associated with the next term in the sequence. For example, \
{\"0\"->\"1\",\"0 1\"->\"0\",....}:\
\>", "CodeText",
 TaggingRules->{},
 CellChangeTimes->{
  3.898176937370902*^9, {3.898177106090897*^9, 3.8981771470152597`*^9}, {
   3.8982066385584593`*^9, 3.8982066907806053`*^9}, 3.898206796894*^9, {
   3.898263683436385*^9, 3.8982636844431753`*^9}},
 CellID->1996349858,ExpressionUUID->"b31a09a1-413e-427f-92dc-522bc46cb6b0"],

Cell[BoxData[
 RowBox[{
