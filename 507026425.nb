Cell[CellGroupData[{

Cell["Conclusion", "Section",
 TaggingRules->{},
 CellChangeTimes->{{3.898253127503125*^9, 3.898253129508522*^9}},
 CellID->1912288429,ExpressionUUID->"25f9fe52-bafc-40b7-ae07-275618a0b675"],

Cell[CellGroupData[{

Cell["\<\
It is incredibly difficult to be able to predict sequences especially since \
many of the sequences share terms\
\>", "Item",
 TaggingRules->{},
 CellChangeTimes->{{3.898258907522234*^9, 3.898258908838627*^9}, {
  3.898260139389153*^9, 3.8982601425109787`*^9}},
 CellID->715136871,ExpressionUUID->"0d8cab2d-7ebc-479d-a696-4f54c98e5907"],

Cell["\<\
For example, multiple sequences have 0,1,1,1 in it. So when using Classify, \
it doesn't know which sequence you are wanting and outputs an average of all \
the possibilities\
\>", "Subitem",
 TaggingRules->{},
 CellChangeTimes->{{3.898258907522234*^9, 3.898258908838627*^9}, 
   3.898260139389153*^9, {3.898260201412449*^9, 3.898260201982065*^9}, {
   3.898260544583202*^9, 3.89826061765469*^9}},
 CellID->288305765,ExpressionUUID->"6f49f1e4-3b47-4cae-8ba2-501e5c0decaa"]
}, Open  ]],

Cell["\<\
Classify  has a low accuracy rate with certain forms of data.\
\>", "Item",
 TaggingRules->{},
 CellChangeTimes->{{3.8982531692377653`*^9, 3.8982532691971397`*^9}, {
   3.898259037452875*^9, 3.898259040407341*^9}, {3.8982606373936768`*^9, 
   3.898260639896018*^9}, {3.8982607634583483`*^9, 3.898260765606497*^9}, 
   3.898266411228355*^9},
 CellID->311462183,ExpressionUUID->"8e69f982-fe54-47aa-acad-1de534b5c96e"],

Cell[CellGroupData[{

Cell["Classify also doesn't care about order.", "Item",
 TaggingRules->{},
 CellChangeTimes->{{3.8982531692377653`*^9, 3.8982532691971397`*^9}, {
  3.898259037452875*^9, 3.898259040407341*^9}, {3.8982606373936768`*^9, 
  3.89826064169359*^9}, {3.898260749088621*^9, 3.898260768869773*^9}},
 CellID->405520476,ExpressionUUID->"6094afd3-069e-47dd-b4c1-2b3a6a8ed1c0"],

Cell["For example 1,2 is the same as 2,1", "Subitem",
 TaggingRules->{},
 CellChangeTimes->{{3.8982531692377653`*^9, 3.8982532691971397`*^9}, {
  3.898259037452875*^9, 3.898259040407341*^9}, {3.8982606373936768`*^9, 
  3.89826064169359*^9}, {3.898260749088621*^9, 3.898260787275196*^9}},
 CellID->2009439950,ExpressionUUID->"b93377a4-0ea5-4955-97c4-b02b22d06649"]
}, Open  ]],

Cell["\<\
There are a lot of patterns that show when looking at a lot of sequences\
\>", "Item",
 TaggingRules->{},
 CellChangeTimes->{{3.8982531692377653`*^9, 3.898253265920663*^9}, {
  3.89825329989415*^9, 3.898253333930394*^9}, {3.8982590532981977`*^9, 
  3.898259053559887*^9}, {3.898266422414257*^9, 3.8982664228456984`*^9}},
 CellID->843284215,ExpressionUUID->"85be4091-28bc-42ed-8881-c94c43befbf9"]
}, Open  ]],

