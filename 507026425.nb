    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
       RowBox[{"ToExpression", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"StringSplit", "[", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", " ", "\"\<,\>\""}], "]"}], 
         "]"}], "]"}]}], "}"}], " ", "&"}], " ", "/@", " ", "stringList"}]}], 
  ";"}]], "Input",
 TaggingRules->{},
