Cell[CellGroupData[{

Cell["Restricting the Data", "Section",
 TaggingRules->{},
 CellChangeTimes->{{3.8980890180956507`*^9, 3.898089025123684*^9}},
 CellID->192292503,ExpressionUUID->"084c3c9a-c94b-493b-bb44-70ac1dd83b6b"],

Cell["\<\
From many tests, it was determined that sequences that contained less than 10 \
terms, had negative numbers, and had terms larger than 100 caused many \
errors. So I decided to remove them from the dataset. For some of the models, \
the sequences had to be non-decreasing as well as the other restrictions.\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.898089217516068*^9, 3.8980892648771973`*^9}, {
  3.898089298957211*^9, 3.898089347817295*^9}, {3.898089869245782*^9, 
  3.898089918266048*^9}, {3.8980901320227127`*^9, 3.898090172857432*^9}, {
  3.89809037373174*^9, 3.898090392222599*^9}, {3.8982592388403378`*^9, 
  3.8982592411814613`*^9}, {3.898259798392591*^9, 3.898259801000393*^9}},
 CellID->59904254,ExpressionUUID->"c8d6463d-6f2a-450e-9a2b-0c40a2b05630"],

Cell["\<\
Creates a limit so that the terms stay smaller than 100 and are all positive:\
\
\>", "CodeText",
 TaggingRules->{},
 CellChangeTimes->{{3.89808996513627*^9, 3.898090008710524*^9}, {
   3.89809006370963*^9, 3.898090070858048*^9}, {3.898090154438115*^9, 
   3.898090156577217*^9}, {3.898090448180509*^9, 3.8980904693593407`*^9}, 
   3.898090764554393*^9},
 CellID->1887883303,ExpressionUUID->"e247fb33-4110-47b4-90b8-dfe54b52f8f2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"boundary", "[", "x_", "]"}], ":=", 
  RowBox[{"AllTrue", "[", 
   RowBox[{"x", ",", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"0", "<=", "#", "<=", "100"}], ")"}], "&"}]}], "]"}]}]], "Input",\

 TaggingRules->{},
 CellChangeTimes->{
  3.89808988863829*^9, {3.898089920507058*^9, 3.8980899380717897`*^9}, {
   3.898090365191103*^9, 3.898090369145527*^9}, {3.898090656243167*^9, 
   3.898090680426282*^9}, 3.89809104866527*^9, 3.898249195542884*^9, 
   3.898249293990211*^9},
 CellLabel->"In[495]:=",
 CellID->1463057685,ExpressionUUID->"ef3956bd-f606-4d43-bc70-8949779bd1f1"],

Cell["Selects all sequences that follow this limit:", "CodeText",
 TaggingRules->{},
 CellChangeTimes->{{3.8980907301341677`*^9, 3.898090762368582*^9}},
 CellID->752830651,ExpressionUUID->"f30df145-5454-4908-937a-62c40d3043a6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sequence2", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"sequence", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"boundary", "[", "#", "]"}], "&&", 
       RowBox[{
        RowBox[{"Length", "[", "#", "]"}], ">=", "11"}]}], "&"}]}], "]"}]}], 
  ";"}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{
  3.898090778759822*^9, 3.898091051112611*^9, 3.898092590162307*^9, {
   3.89809298471791*^9, 3.898092985677354*^9}, {3.898093362103997*^9, 
   3.898093364925715*^9}, {3.898093477729961*^9, 3.898093482975782*^9}, {
   3.898093884094624*^9, 3.898093889382965*^9}, 3.8982636600037107`*^9},
 CellLabel->"In[553]:=",
 CellID->880593942,ExpressionUUID->"75434d7e-e05a-4bcb-8087-5d56abfe1e89"],

Cell["\<\
For some of the models, the sequences had to be non-decreasing as well as the \
other restrictions.\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.898090983740309*^9, 3.898090994141979*^9}, {
  3.898259809491262*^9, 3.898259812422481*^9}},
 CellID->304780246,ExpressionUUID->"30e26f8f-68ad-4923-be63-622932dced56"],

Cell["\<\
Creates limit so that all the sequences have terms that are not decreasing\
\>", "CodeText",
 TaggingRules->{},
 CellChangeTimes->{{3.8980910174129887`*^9, 3.898091068237444*^9}, {
  3.898259816786912*^9, 3.8982598231065493`*^9}},
 CellID->470984442,ExpressionUUID->"3ec5fb6f-b9f6-4939-b532-3b5dc072afad"],

Cell[BoxData[
 RowBox[{
  RowBox[{"increasing", "[", "x_", "]"}], ":=", 
  RowBox[{"AllTrue", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x", "[", 
         RowBox[{"[", "n", "]"}], "]"}], "<=", 
        RowBox[{"x", "[", 
         RowBox[{"[", 
          RowBox[{"n", "+", "1"}], "]"}], "]"}]}], ")"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", 
        RowBox[{"Range", "[", 
         RowBox[{"1", ",", 
          RowBox[{
           RowBox[{"Length", "[", "x", "]"}], "-", "1"}]}], "]"}]}], "}"}]}], 
     "]"}], ",", "TrueQ"}], "]"}]}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.8980903587388887`*^9, 3.898090358741967*^9}, {
  3.898090668056096*^9, 3.898090677912457*^9}, {3.898090774150625*^9, 
  3.898090775187608*^9}, {3.8980910732044783`*^9, 3.898091073577517*^9}},
 CellID->1010063432,ExpressionUUID->"891f8b75-ee7c-4e57-b91f-b70985ab51de"],

Cell["Selects all the sequences that follow that ", "CodeText",
 TaggingRules->{},
 CellChangeTimes->{{3.898091086563636*^9, 3.898091097248568*^9}},
 CellID->1210321736,ExpressionUUID->"2d3de063-e3f9-4e70-ad83-f457fd0b3922"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sequence3", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"sequence", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"boundary", "[", "#", "]"}], "&&", 
       RowBox[{
        RowBox[{"Length", "[", "#", "]"}], ">=", "11"}], "&&", 
       RowBox[{"increasing", "[", "#", "]"}]}], "&"}]}], "]"}]}], 
  ";"}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.898092122510893*^9, 3.898092130502514*^9}, {
   3.898093399961658*^9, 3.898093399966254*^9}, {3.89809347222373*^9, 
   3.898093487183743*^9}, 3.898093887096362*^9, {3.8980967799715347`*^9, 
   3.898096781100223*^9}},
 CellLabel->"In[99]:=",
