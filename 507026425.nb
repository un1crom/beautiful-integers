       RowBox[{"Drop", "[", 
        RowBox[{"#", ",", " ", "1"}], "]"}]}], "}"}], " ", "&"}], " ", "/@", 
    " ", "list"}]}], ";"}]], "Input",
 TaggingRules->{},
