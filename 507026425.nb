      RowBox[{"LinearLayer", "[", "]"}]}], "}"}], ",", 
    RowBox[{"\"\<Input\>\"", "->", "enc"}], ",", 
    RowBox[{"\"\<Output\>\"", "->", "dec"}]}], "]"}]}]], "Input",
 TaggingRules->{},
