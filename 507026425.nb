 CellLabel->"In[543]:=",
 CellID->1476108647,ExpressionUUID->"e4ee7251-af55-4c85-813c-dc3d433b1bca"],

Cell["\<\
The graph, as shown below, starts to create a pattern of sequences being \
trapped within a small range. When given more data, this pattern is present \
in a wider range:\
\>", "CodeText",
 TaggingRules->{},
 CellChangeTimes->{{3.8982514117739973`*^9, 3.8982514603316383`*^9}, {
  3.898260952641944*^9, 3.898260995895298*^9}, {3.898266360804596*^9, 
  3.8982663668129597`*^9}},
 CellID->1276775018,ExpressionUUID->"20c51e12-43a8-469f-9e76-2ebee087a615"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DirectedGraph", "[", 
  RowBox[{"method2Set2", ",", 
   RowBox[{
    RowBox[{
     RowBox[{"VertexLabels", "->", 
      RowBox[{"#", "->", 
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], "&"}], "/@", 
    RowBox[{"DeleteDuplicates", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "&"}], ",", 
         "method2Set2"}], "]"}], ",", "1"}], "]"}], "]"}]}], ",", 
   RowBox[{"VertexCoordinates", "->", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"10", "-", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], "&"}], "/@", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "&"}], ",", 
           "method2Set2"}], "]"}], ",", "1"}], "]"}], "]"}]}], ")"}]}]}], 
  "]"}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.898182777789214*^9, 3.898182778189993*^9}, {
